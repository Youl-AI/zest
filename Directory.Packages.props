    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="PDFtoImage" Version="5.4.0" />
    <PackageVersion Include="Markdig" Version="1.4.2" />
    <PackageVersion Include="ReverseMarkdown" Version="6.3.0" />
    <PackageVersion Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" />
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>
