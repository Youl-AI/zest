<UserControl x:Class="Zest.App.Jobs.ProgressCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wheel="clr-namespace:Zest.App.Wheel"
             xmlns:jobs="clr-namespace:Zest.App.Jobs"
             Width="{x:Static jobs:ProgressCard.OuterWidth}" Padding="{x:Static jobs:ProgressCard.ShadowRoom}" Cursor="Hand"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <!--
        The popup page's progress card: 344 px, radius 12, window colour with a 1 px line and one soft shadow. The padding
        leaves room for the shadow inside the transparent host window (and is the 10 px gap between stacked cards).
        Top row: [state badge] title over detail [percent] [취소 | done badge]; under it a 3 px bar in the job's citrus ink.
    -->
    <Grid>
        <!-- The shadow sits on its own layer so the effect never rasterizes the text. ProgressCard sets its effect. -->
        <Border x:Name="Shadow" CornerRadius="12" Background="{DynamicResource Zest.Window}" />
        <Border x:Name="Surface" CornerRadius="12" BorderThickness="1" Padding="14,12,12,12"
                Background="{DynamicResource Zest.Window}" BorderBrush="{DynamicResource Zest.Line}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Waiting (clock on seg) or failed ("!" on the danger wash). -->
                    <Border x:Name="LeadBadge" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="Collapsed" Background="{DynamicResource Zest.Seg}">
                        <TextBlock x:Name="LeadGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource Zest.Text2}" />
                    </Border>

                    <!-- Min height = the 32 px cancel button, so the card keeps its height when the button goes. -->
                    <StackPanel Grid.Column="1" MinHeight="32" VerticalAlignment="Center" Orientation="Vertical">
                        <TextBlock x:Name="TitleText" FontFamily="{x:Static wheel:WheelStyle.ChipFont}" FontSize="13.5" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource Zest.Text}" />
                        <TextBlock x:Name="DetailText" Margin="0,1,0,0" FontFamily="{x:Static wheel:WheelStyle.TextFont}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Typography.NumeralAlignment="Tabular"
                                   LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource Zest.Text2}" />
                    </StackPanel>

                    <TextBlock x:Name="PercentText" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                               FontFamily="{x:Static wheel:WheelStyle.TextFont}" FontSize="12" FontWeight="Bold"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Zest.Text2}" />

                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <Button x:Name="CancelButton" Style="{StaticResource Zest.GhostButton}" Margin="6,0,0,0"
                                Content="취소" Cursor="Arrow" Focusable="False" />
                        <!-- Done: a check in the job's citrus. -->
                        <Border x:Name="DoneBadge" Width="22" Height="22" CornerRadius="11" Margin="10,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="DoneGlyph" Text="&#xE73E;" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons" FontSize="12" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- 3 px bar: line track, citrus-ink fill (ProgressCard sizes the fill and runs the indeterminate sweep). -->
                <Grid x:Name="Bar" Height="3" Margin="0,10,0,0" ClipToBounds="True">
                    <Border CornerRadius="1.5" Background="{DynamicResource Zest.Line}" />
                    <Border x:Name="BarFill" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
