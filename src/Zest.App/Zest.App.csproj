<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Zest</AssemblyName>
    <RootNamespace>Zest.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Release version: release.ps1 reads it for the zip name. Keep app.manifest's assemblyIdentity (1.0.0.0) in step. -->
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zest.Core\Zest.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\NOTICE.md" LogicalName="NOTICE.md" />
    <Resource Include="Assets\Fonts\Pretendard-SemiBold.otf" />
  </ItemGroup>
</Project>
