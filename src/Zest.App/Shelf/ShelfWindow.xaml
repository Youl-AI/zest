<Window x:Class="Zest.App.Shelf.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wheel="clr-namespace:Zest.App.Wheel"
        Title="Zest 선반" Width="324" SizeToContent="Height" MinWidth="0" MinHeight="0"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual" AllowDrop="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Zest;component/Tools/ToolStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A 26 px round header button (seg fill, text-2 glyph; line-strong on hover). Not focusable: the shelf never takes focus. -->
            <Style x:Key="Mini" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="FontFamily" Value="{x:Static wheel:WheelStyle.IconFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Background" Value="{DynamicResource Zest.Seg}" />
                <Setter Property="Foreground" Value="{DynamicResource Zest.Text2}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Disc" CornerRadius="13" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Disc" Property="Background" Value="{DynamicResource Zest.LineStrong}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Zest.Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Grid view (first): three columns of 44 px icon tiles with a two-line name ── -->
            <ItemsPanelTemplate x:Key="GridPanel">
                <UniformGrid Columns="3" VerticalAlignment="Top" />
            </ItemsPanelTemplate>
            <Style x:Key="GridItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="4,10,4,8" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ToolTip" Value="{Binding Path}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <!-- Selected: lime wash with a 1 px lime-ink edge. -->
                            <Border x:Name="Tile" CornerRadius="10" BorderThickness="1" Background="Transparent" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Zest.Seg}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Zest.Lime.Wash}" />
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Zest.Lime.Ink}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="GridTile">
                <StackPanel x:Name="Tile">
                    <Border Width="44" Height="44" CornerRadius="9" BorderThickness="1" HorizontalAlignment="Center"
                            Background="{DynamicResource Zest.Raised}" BorderBrush="{DynamicResource Zest.Line}">
                        <Image Source="{Binding LargeIcon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Margin="0,6,0,0" Text="{Binding Name}" TextAlignment="Center" HorizontalAlignment="Center"
                               FontFamily="{x:Static wheel:WheelStyle.TextFont}" FontSize="11.5" Typography.NumeralAlignment="Tabular"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="30"
                               Foreground="{DynamicResource Zest.Text}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <!-- Gone from where it was (moved or deleted elsewhere): dimmed, and left out of drags. -->
                    <DataTrigger Binding="{Binding Missing}" Value="True">
                        <Setter TargetName="Tile" Property="Opacity" Value="0.4" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- ── List view: one 32 px row per item, 16 px icon and the name ── -->
            <ItemsPanelTemplate x:Key="ListPanel">
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
            <Style x:Key="ListItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="10,0,8,0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ToolTip" Value="{Binding Path}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" CornerRadius="8" BorderThickness="1" Background="Transparent" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Zest.Seg}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Zest.Lime.Wash}" />
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Zest.Lime.Ink}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="ListRow">
                <Grid x:Name="Line" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Name}" Style="{StaticResource Number}"
                               Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Missing}" Value="True">
                        <Setter TargetName="Line" Property="Opacity" Value="0.4" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 12 px on the sides and 16 below leave room for the shadow inside the transparent window; the tab floats just above the card. -->
    <Grid x:Name="Root" Margin="12,0,12,16">
        <!-- The shadow on its own layer (ShelfWindow gives it the cards' shadow), so the effect never rasterizes the text. -->
        <Border x:Name="ShadowLayer" Margin="0,6,0,0" CornerRadius="14" Background="{DynamicResource Zest.Window}" />
        <Border x:Name="Card" Margin="0,6,0,0" CornerRadius="14" BorderThickness="1"
                Background="{DynamicResource Zest.Window}" BorderBrush="{DynamicResource Zest.Line}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: drag to move the shelf. -->
                <Grid x:Name="Header" Margin="0" Background="Transparent" Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,12,0,10" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontFamily="{x:Static wheel:WheelStyle.ChipFont}" FontSize="13.5" FontWeight="Bold"
                                   Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Zest.Text}" />
                        <TextBlock x:Name="HintText" Margin="0,1,0,0" Text="끌어서 꺼내기" FontSize="12" Style="{StaticResource Detail}" />
                    </StackPanel>
                    <Button x:Name="ViewButton" Grid.Column="1" Style="{StaticResource Mini}" />
                    <Button x:Name="CloseButton" Grid.Column="2" Margin="8,0,10,0" Style="{StaticResource Mini}" FontSize="10"
                            Content="&#xE711;" ToolTip="선반 닫기 (파일은 그대로 있습니다)"
                            AutomationProperties.Name="선반 닫기 (파일은 그대로 있습니다)" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Divider}" />

                <ListBox x:Name="List" Grid.Row="2" Background="Transparent" BorderThickness="0" MaxHeight="320"
                         SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Grid>
        </Border>

        <!-- Lime outline while files are dragged over the shelf (an overlay, so the layout never shifts). -->
        <Border x:Name="DropRing" Margin="0,6,0,0" CornerRadius="14" BorderThickness="1.5" IsHitTestVisible="False"
                BorderBrush="{DynamicResource Zest.Lime.Ink}" Visibility="Collapsed" />

        <!-- Lime grip tab, 36 x 5, centred just above the card's top edge. -->
        <Border x:Name="Tab" Width="36" Height="5" CornerRadius="2.5" VerticalAlignment="Top" HorizontalAlignment="Center"
                IsHitTestVisible="False" Background="{DynamicResource Zest.Lime.Ink}" />
    </Grid>
</Window>
