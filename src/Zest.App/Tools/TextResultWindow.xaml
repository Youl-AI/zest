<theme:ZestWindow x:Class="Zest.App.Tools.TextResultWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:theme="clr-namespace:Zest.App.Theme"
                  Heading="글자 복사" Width="508" Height="428" MinWidth="408" MinHeight="308" IsResizable="True">
    <!-- Width = the page's 460 px frame + 2 x ZestWindow.ShadowMargin; a fixed height so long text scrolls inside the box. -->
    <theme:ZestWindow.Resources>
        <ResourceDictionary Source="ToolStyles.xaml" />
    </theme:ZestWindow.Resources>

    <theme:ZestWindow.Footer>
        <DockPanel Style="{StaticResource Zest.FooterBar}">
            <ui:Button x:Name="CopyButton" TabIndex="2" Appearance="Primary" Content="복사">
                <!-- Disabled when no text was found: stays tangerine (faded), not WPF-UI's grey disabled fill. -->
                <ui:Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{x:Static theme:ZestTheme.PrimaryFill}" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{x:Static theme:ZestTheme.PrimaryOnFill}" />
                </ui:Button.Resources>
            </ui:Button>
            <ui:Button x:Name="SaveButton" TabIndex="1" Content="텍스트로 저장" />
            <ui:Button x:Name="CloseButton" TabIndex="0" IsCancel="True" Content="닫기" />
        </DockPanel>
    </theme:ZestWindow.Footer>

    <Grid Margin="20,0,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0 source name + copied chip -->
            <RowDefinition Height="*" />    <!-- 1 text / empty message -->
            <RowDefinition Height="Auto" /> <!-- 2 status (clipboard busy, save started) -->
        </Grid.RowDefinitions>

        <DockPanel Margin="0,2,0,10">
            <Border x:Name="CopiedChip" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource Zest.Chip}"
                    Background="{DynamicResource Zest.Lime.Wash}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Margin="-2,0,2,0" VerticalAlignment="Center" Data="{StaticResource CheckGlyph}"
                          Stroke="{DynamicResource Zest.Lime.Ink}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <TextBlock Text="클립보드에 복사함" Style="{StaticResource Zest.ChipText}" Foreground="{DynamicResource Zest.Lime.Ink}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="SourceText" Style="{StaticResource Detail}" />
        </DockPanel>

        <TextBox x:Name="ResultBox" Grid.Row="1" Style="{StaticResource TextArea}" />
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="글자를 찾지 못했습니다." Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label}" />

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                   Style="{StaticResource Zest.Hint}" Visibility="Collapsed" />
    </Grid>
</theme:ZestWindow>
