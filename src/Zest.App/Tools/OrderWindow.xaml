<theme:ZestWindow x:Class="Zest.App.Tools.OrderWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:theme="clr-namespace:Zest.App.Theme"
                  xmlns:wheel="clr-namespace:Zest.App.Wheel"
                  Heading="PDF 만들기" Width="488" SizeToContent="Height">
    <!-- Width = the page's 440 px frame + 2 x ZestWindow.ShadowMargin. -->
    <theme:ZestWindow.Resources>
        <ResourceDictionary Source="ToolStyles.xaml" />
    </theme:ZestWindow.Resources>

    <theme:ZestWindow.Footer>
        <!-- Right to left: the verb (8 px more air before it, as on the page), then ↓ and ↑. -->
        <DockPanel Style="{StaticResource Zest.FooterBar}">
            <ui:Button x:Name="GoButton" Margin="16,0,0,0" Appearance="Primary" IsDefault="True" Content="만들기" />
            <ui:Button x:Name="DownButton" Width="32" Padding="0" ToolTip="아래로" AutomationProperties.Name="아래로">
                <TextBlock Text="&#xE74B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{DynamicResource Zest.Text}" />
            </ui:Button>
            <ui:Button x:Name="UpButton" Width="32" Padding="0" ToolTip="위로" AutomationProperties.Name="위로">
                <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{DynamicResource Zest.Text}" />
            </ui:Button>
        </DockPanel>
    </theme:ZestWindow.Footer>

    <StackPanel Margin="20,0">
        <TextBlock x:Name="HintText" Margin="0,2,0,0" Text="끌거나 화살표로 순서를 바꾸세요." Style="{StaticResource Zest.Hint}" />

        <ListBox x:Name="List" Margin="0,4,0,8" Padding="0" Background="Transparent" BorderThickness="0" MaxHeight="336"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <!-- A row: radius 9, seg on hover; the selected row is washed in tangerine (no accent pill). -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,6,10,6" />
                    <Setter Property="Margin" Value="0,2,0,0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Foreground" Value="{DynamicResource Zest.Text}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Zest.Seg}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Zest.Tangerine.Wash}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- position · 44 x 33 thumbnail · name over detail · grip, 12 px apart. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Position}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource Detail}" />
                        <!-- Thumbnail (images) or a PDF glyph, radius 5 with a 1 px line edge. -->
                        <Grid Grid.Column="2" Width="44" Height="33" VerticalAlignment="Center">
                            <Border CornerRadius="5" Background="{DynamicResource Zest.Seg}" />
                            <TextBlock Text="&#xEA90;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Zest.Text2}" Visibility="{Binding GlyphVisibility}" />
                            <Border CornerRadius="5" Visibility="{Binding ThumbnailVisibility}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Zest.Line}" />
                        </Grid>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontFamily="{x:Static wheel:WheelStyle.TextFont}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Zest.Text}" />
                            <TextBlock Text="{Binding Detail}" Margin="0,1,0,0" FontSize="12" Style="{StaticResource Detail}" />
                        </StackPanel>
                        <Path Grid.Column="6" Width="20" Height="20" VerticalAlignment="Center" Data="{StaticResource GripGlyph}"
                              Fill="{DynamicResource Zest.Text3}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</theme:ZestWindow>
