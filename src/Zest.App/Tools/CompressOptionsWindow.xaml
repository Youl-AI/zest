<theme:ZestWindow x:Class="Zest.App.Tools.CompressOptionsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:theme="clr-namespace:Zest.App.Theme"
                  xmlns:wheel="clr-namespace:Zest.App.Wheel"
                  Heading="압축" Width="448" SizeToContent="Height">
    <!-- Width = the page's 400 px frame + 2 x ZestWindow.ShadowMargin. -->
    <theme:ZestWindow.Resources>
        <ResourceDictionary Source="ToolStyles.xaml" />
    </theme:ZestWindow.Resources>

    <theme:ZestWindow.Footer>
        <DockPanel Style="{StaticResource Zest.FooterBar}">
            <ui:Button x:Name="CompressButton" Appearance="Primary" IsDefault="True" Content="압축" />
            <!-- Left: the error line when there is one, otherwise where the result goes. -->
            <Grid>
                <TextBlock x:Name="HintText" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" />
            </Grid>
        </DockPanel>
    </theme:ZestWindow.Footer>

    <StackPanel Margin="20,0">
        <!-- File and its size. -->
        <StackPanel Margin="0,6,0,14">
            <TextBlock x:Name="FileNameText" Style="{StaticResource Detail}" />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Big}">
                <Run x:Name="SizeCaption" Text="원본 크기" /><Run Text=" " /><Run x:Name="SizeValue" FontFamily="{x:Static wheel:WheelStyle.TextFont}" />
            </TextBlock>
        </StackPanel>

        <Border Style="{StaticResource Zest.Hairline}" />

        <!-- Mode: one segment row; only the chosen mode's panel shows under it. -->
        <StackPanel Margin="0,14">
            <Border Style="{StaticResource Zest.SegmentPanel}">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="PresetRadio" GroupName="Goal" Content="프리셋" Style="{StaticResource Zest.Segment}" />
                    <RadioButton x:Name="TargetRadio" GroupName="Goal" Content="목표 크기" Style="{StaticResource Zest.Segment}" />
                    <RadioButton x:Name="PercentRadio" GroupName="Goal" Content="비율" Style="{StaticResource Zest.Segment}" />
                </UniformGrid>
            </Border>

            <Border x:Name="PresetPanel" Margin="0,10,0,0" Style="{StaticResource Zest.SegmentPanel}">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="GentleRadio" GroupName="Level" Content="약하게" Style="{StaticResource Zest.Segment}" />
                    <RadioButton x:Name="HardRadio" GroupName="Level" Content="세게" Style="{StaticResource Zest.Segment}" />
                </UniformGrid>
            </Border>

            <DockPanel x:Name="TargetPanel" Margin="0,10,0,0">
                <Grid DockPanel.Dock="Right" Width="180">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox" Style="{StaticResource NumberField}" />
                    <ComboBox x:Name="UnitBox" Grid.Column="2" Style="{StaticResource Combo}" FontFamily="{x:Static wheel:WheelStyle.TextFont}">
                        <ComboBoxItem Content="KB" />
                        <ComboBoxItem Content="MB" />
                    </ComboBox>
                </Grid>
                <TextBlock Text="목표" Style="{StaticResource Label}" />
            </DockPanel>

            <StackPanel x:Name="PercentPanel" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Style="{StaticResource Value}" />
                    <TextBlock Text="줄이기" Style="{StaticResource Label}" />
                </DockPanel>
                <Slider x:Name="PercentSlider" Margin="0,10,0,0" Minimum="1" Maximum="99" SmallChange="1" LargeChange="10"
                        IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource Slider}" />
                <!-- Only the number stands out, in tangerine ink. -->
                <TextBlock x:Name="EstimateText" Margin="0,10,0,0" Style="{StaticResource Zest.Hint}">
                    <Run Text="예상 " /><Run x:Name="EstimateValue" FontWeight="Bold" Typography.NumeralAlignment="Tabular"
                                            Foreground="{DynamicResource Zest.Tangerine.Ink}" /><Run Text=" 이하" />
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Zest.Hairline}" />

        <DockPanel Margin="0,14">
            <ComboBox x:Name="CapBox" DockPanel.Dock="Right" Width="180" Style="{StaticResource Combo}" />
            <TextBlock Text="최대 크기" Style="{StaticResource Label}" />
        </DockPanel>
    </StackPanel>
</theme:ZestWindow>
