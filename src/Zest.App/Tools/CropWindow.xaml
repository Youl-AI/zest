<theme:ZestWindow x:Class="Zest.App.Tools.CropWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:theme="clr-namespace:Zest.App.Theme"
                  xmlns:tools="clr-namespace:Zest.App.Tools"
                  Heading="자르기" Width="816" MinWidth="816" MinHeight="408" SizeToContent="Height" IsResizable="True">
    <!-- Width = the page's 768 px frame + 2 x ZestWindow.ShadowMargin; the minimum keeps the control row on one line. -->
    <theme:ZestWindow.Resources>
        <ResourceDictionary Source="ToolStyles.xaml" />
    </theme:ZestWindow.Resources>

    <theme:ZestWindow.Footer>
        <DockPanel Style="{StaticResource Zest.FooterBar}">
            <ui:Button x:Name="CropButton" Appearance="Primary" IsDefault="True" Content="자르기" />
        </DockPanel>
    </theme:ZestWindow.Footer>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Preview: inset 16 from the frame, radius 10 on the sunken colour; the canvas keeps the image 16 px inside it. -->
        <Border x:Name="PreviewArea" Margin="16,0" CornerRadius="10" Background="{DynamicResource Zest.Sunken}">
            <tools:CropCanvas x:Name="Canvas" />
        </Border>

        <!-- One control row: the ratio chips (built from CropWindow.Ratios), then X / Y / 폭 / 높이. -->
        <StackPanel Grid.Row="1" Margin="16,14" Orientation="Horizontal">
            <StackPanel x:Name="RatioPanel" Orientation="Horizontal" VerticalAlignment="Center" />
            <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource NumberField}">
                        <Setter Property="Width" Value="72" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="X" />
                <TextBox x:Name="XBox" />
                <TextBlock Text="Y" Margin="8,0,6,0" />
                <TextBox x:Name="YBox" />
                <TextBlock Text="폭" Margin="8,0,6,0" />
                <TextBox x:Name="WidthBox" />
                <TextBlock Text="높이" Margin="8,0,6,0" />
                <TextBox x:Name="HeightBox" />
            </StackPanel>
        </StackPanel>
    </Grid>
</theme:ZestWindow>
