<theme:ZestWindow x:Class="Zest.App.Tools.ModelDownloadWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:theme="clr-namespace:Zest.App.Theme"
                  xmlns:wheel="clr-namespace:Zest.App.Wheel"
                  Heading="배경 제거" Width="468" SizeToContent="Height">
    <!-- Width = the page's 420 px frame + 2 x ZestWindow.ShadowMargin. -->
    <theme:ZestWindow.Resources>
        <ResourceDictionary Source="ToolStyles.xaml" />
    </theme:ZestWindow.Resources>

    <theme:ZestWindow.Footer>
        <DockPanel Style="{StaticResource Zest.FooterBar}">
            <ui:Button x:Name="DownloadButton" TabIndex="1" Appearance="Primary" IsDefault="True" Content="내려받기">
                <!-- Disabled while downloading: stays tangerine (faded), not WPF-UI's grey disabled fill. -->
                <ui:Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{x:Static theme:ZestTheme.PrimaryFill}" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{x:Static theme:ZestTheme.PrimaryOnFill}" />
                </ui:Button.Resources>
            </ui:Button>
            <ui:Button x:Name="CancelButton" TabIndex="0" IsCancel="True" Content="취소" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" />
        </DockPanel>
    </theme:ZestWindow.Footer>

    <StackPanel Margin="20,0">
        <!-- What and why: a tangerine-wash tile with the ink glyph beside the headline and the explanation. -->
        <Grid Margin="0,6,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="12" VerticalAlignment="Top" Background="{DynamicResource Zest.Tangerine.Wash}">
                <Path Width="24" Height="24" Data="{StaticResource CloudDownloadGlyph}" Stroke="{DynamicResource Zest.Tangerine.Ink}"
                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Border>
            <StackPanel Grid.Column="2">
                <TextBlock Text="배경 제거 모델이 필요합니다" Style="{StaticResource Big}" />
                <!-- Explicit line breaks: WPF breaks Korean inside words. -->
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Body}">
                    처음 한 번만 내려받습니다(<Run x:Name="SizeRun" FontFamily="{x:Static wheel:WheelStyle.TextFont}" Text="973 MB" />).<LineBreak />이미지는 이 PC 안에서만 처리하고<LineBreak />밖으로 보내지 않습니다.
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Progress, shown once the download starts: phase and amount, then a 4 px tangerine-ink bar. -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Zest.Hairline}" />
            <StackPanel Margin="0,14">
                <DockPanel>
                    <TextBlock x:Name="AmountText" DockPanel.Dock="Right" Style="{StaticResource Value}" />
                    <TextBlock x:Name="PhaseText" Style="{StaticResource Label}" />
                </DockPanel>
                <ProgressBar x:Name="LoadBar" Margin="0,10,0,0" Minimum="0" Maximum="1" IsIndeterminate="True" Style="{StaticResource Bar}" />
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Zest.Hairline}" />
        <DockPanel Margin="0,14">
            <TextBlock DockPanel.Dock="Left" Text="저장 위치" Style="{StaticResource Label}" />
            <TextBlock Margin="12,0,0,0" Text="%LOCALAPPDATA%\Zest\models" FontSize="12.5" HorizontalAlignment="Right" TextAlignment="Right"
                       Style="{StaticResource Detail}" />
        </DockPanel>
    </StackPanel>
</theme:ZestWindow>
