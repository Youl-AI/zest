<UserControl x:Class="LimeWin.App.Wheel.WheelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Height="320" IsHitTestVisible="False"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <!-- Layers, bottom to top: blurred screen capture, tint film, rim lines, petals, hub. Shapes and values come from WheelStyle. -->
    <Grid>
        <!-- Cached so the blur is computed once per capture, not on every frame of the highlight animation. -->
        <Grid x:Name="Glass">
            <Grid.CacheMode>
                <BitmapCache SnapsToDevicePixels="True" />
            </Grid.CacheMode>
            <Image x:Name="Backdrop" Width="320" Height="320" Stretch="Fill" />
        </Grid>
        <Path x:Name="Tint" />
        <Path x:Name="Ring" />
        <Path x:Name="InnerLine" />
        <Canvas x:Name="Petals" />
        <Ellipse x:Name="Hub" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="CenterText" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
    </Grid>
</UserControl>
