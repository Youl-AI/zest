<UserControl x:Class="LimeWin.App.Wheel.WheelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Height="320" IsHitTestVisible="False">
    <Grid>
        <Canvas x:Name="Petals" />
        <Ellipse x:Name="Hole" Width="92" Height="92" Fill="#E6F5F5F5" Visibility="Collapsed" />
        <TextBlock x:Name="CenterText" Width="84" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A" />
    </Grid>
</UserControl>
