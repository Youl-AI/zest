<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wheel="clr-namespace:LimeWin.App.Wheel">
    <!-- Shared look of the tool windows: 8 px grid, Pretendard for Korean labels, the system face for names and numbers. -->

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{x:Static wheel:WheelStyle.KoreanFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="Detail" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{x:Static wheel:WheelStyle.TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="Number" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{x:Static wheel:WheelStyle.TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- Hairline between groups, like the original's dividers. -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{x:Static wheel:WheelStyle.TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
    </Style>
</ResourceDictionary>
