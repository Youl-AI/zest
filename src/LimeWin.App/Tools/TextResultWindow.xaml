<ui:FluentWindow x:Class="LimeWin.App.Tools.TextResultWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wheel="clr-namespace:LimeWin.App.Wheel"
                 Title="글자 복사" Width="560" Height="460" MinWidth="360" MinHeight="260" ResizeMode="CanResizeWithGrip"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStartupLocation="Manual">
    <ui:FluentWindow.Resources>
        <ResourceDictionary Source="ToolStyles.xaml" />
    </ui:FluentWindow.Resources>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" Title="글자 복사" ShowMinimize="False" ShowMaximize="False"
                     Padding="24,0,0,0" ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0 source name -->
                <RowDefinition Height="Auto" /> <!-- 1 status -->
                <RowDefinition Height="*" />    <!-- 2 text / empty message -->
                <RowDefinition Height="Auto" /> <!-- 3 buttons -->
            </Grid.RowDefinitions>

            <TextBlock x:Name="SourceText" Style="{StaticResource Detail}" />
            <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,4,0,12" TextWrapping="Wrap" Style="{StaticResource SecondaryLabel}" />

            <TextBox x:Name="ResultBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="{x:Static wheel:WheelStyle.TextFont}" FontSize="14"
                     VerticalContentAlignment="Top" />
            <TextBlock x:Name="EmptyText" Grid.Row="2" Text="글자를 찾지 못했습니다." Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SecondaryLabel}" />

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="SaveButton" Grid.Column="1" Margin="0,0,8,0" MinWidth="96" Padding="16,6"
                           Content="텍스트로 저장" FontFamily="{x:Static wheel:WheelStyle.KoreanFont}" />
                <ui:Button x:Name="CopyButton" Grid.Column="2" Margin="0,0,8,0" MinWidth="72" Padding="16,6" Appearance="Primary"
                           Content="복사" FontFamily="{x:Static wheel:WheelStyle.KoreanFont}" />
                <ui:Button x:Name="CloseButton" Grid.Column="3" MinWidth="72" Padding="16,6" IsCancel="True"
                           Content="닫기" FontFamily="{x:Static wheel:WheelStyle.KoreanFont}" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
