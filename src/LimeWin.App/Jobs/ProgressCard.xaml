<UserControl x:Class="LimeWin.App.Jobs.ProgressCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="320" Margin="0,8,0,0" Cursor="Hand">
    <ui:Card Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Grid.ColumnSpan="2" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ProgressBar x:Name="Bar" Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,8,0,8" Minimum="0" Maximum="1" IsIndeterminate="True" />
            <TextBlock x:Name="StatusText" Grid.Row="2" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="변환 중…" />
            <ui:Button x:Name="CancelButton" Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" Padding="10,2" Content="취소" Cursor="Arrow" />
        </Grid>
    </ui:Card>
</UserControl>
