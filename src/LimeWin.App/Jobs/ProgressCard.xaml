<UserControl x:Class="LimeWin.App.Jobs.ProgressCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="344" Padding="12,0,12,12" Cursor="Hand"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <!-- 12 px padding leaves room for the shadow inside the transparent host window. -->
    <Border x:Name="Surface" CornerRadius="8" BorderThickness="1" Padding="14,12,12,12"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.16" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="StateIcon" Grid.RowSpan="3" Margin="0,1,12,0" VerticalAlignment="Top"
                       FontFamily="Segoe Fluent Icons" FontSize="20" Text="&#xE7C3;"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center"
                       FontFamily="Segoe UI Variable Text" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Button x:Name="CancelButton" Grid.Column="2" Grid.RowSpan="2" Margin="10,0,0,0" Padding="12,4"
                       VerticalAlignment="Center" Content="취소" FontSize="12" Cursor="Arrow" />
            <ProgressBar x:Name="Bar" Grid.Row="1" Grid.Column="1" Height="4" Margin="0,8,0,0"
                         Minimum="0" Maximum="1" IsIndeterminate="True" />
            <TextBlock x:Name="StatusText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                       FontFamily="Segoe UI Variable Text" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="변환 중…" />
        </Grid>
    </Border>
</UserControl>
